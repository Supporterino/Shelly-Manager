{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-capability",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*/*" },
        { "url": "https://api.open-meteo.com/*" },
        { "url": "https://geocoding-api.open-meteo.com/*" }
      ]
    },
    "websocket:default",
    "store:default"
  ]
}
